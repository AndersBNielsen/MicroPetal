{
  "name": "micropetal-explainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.tsx",
    "render": "node scripts/render.mjs",
    "build": "npm run narrate && npm run render",
    "check": "tsc --noEmit && python3 scripts/check.py",
    "narrate": "python3 scripts/prepare.py"
  },
  "dependencies": {
    "remotion": "4.0.545",
    "@remotion/cli": "4.0.545",
    "@remotion/bundler": "4.0.545",
    "@remotion/renderer": "4.0.545",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2"
  }
}
